# MAME romset - never commit ROMs
ncv1/
*.zip
*.rom
*.bin
# the Pocket package's own binaries are not ROMs
!pkg/pocket/Platforms/_images/*.bin
!pkg/pocket/Cores/*/icon.bin

# scratch
tmp/
ref/mame/
sim/obj_*/
*.o
*.a

# build output
output_files/
db/
incremental_db/
greybox_tmp/
.qsys_edit/

.DS_Store

# large captures stay local
artifacts/*.wav
artifacts/mame_regions.txt
artifacts/rtl/
sim/obj_*/
sim/*.log
artifacts/system/*_reads.txt
artifacts/system/*.rgb
artifacts/system/*.rgb.f*

# MAME pin-traffic capture (reconstructable EEPROM contents); regenerate with tools/probe_late.lua
artifacts/system/mame_late.txt

# bench audio captures are regenerated by sim/run_system.sh (AUDIO=1)
artifacts/system/*.wav
artifacts/ghidra/
artifacts/ncv1.rom
error.log
artifacts/h8*/
artifacts/c352/*.wav
artifacts/c352/*_log.txt

# vendor manuals: download from the vendor, never redistribute
ref/docs/*.pdf
ref/docs/*.txt
