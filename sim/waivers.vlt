`verilator_config
// Vendored / generated cores are waived by path. Nothing under rtl/ is waived
// wholesale; a genuine don't-care gets a narrow lint_off in the source with
// a reason on the line above (docs/rtl-conventions.md).
lint_off -file "*modules/cpu-fx68k/*"
// the H8/300H core's tasks assign registers from several call sites inside
// one always_ff; Verilator reports that as multiple drivers, Quartus does not
lint_off -rule MULTIDRIVEN -file "*rtl/h8300h.sv"
lint_off -rule MULTIDRIVEN -file "*rtl/h83002.sv"
